{
  "id": "PostpilotGenerate01",
  "name": "Postpilot \u00b7 generate",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "PostpilotErrors001",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "n-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "postpilot-generate",
      "parameters": {
        "httpMethod": "POST",
        "path": "postpilot-generate",
        "responseMode": "onReceived",
        "options": {},
        "authentication": "headerAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PpHeaderAuth00001",
          "name": "Postpilot app secret"
        }
      }
    },
    {
      "id": "n-tag",
      "name": "Tag execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const campaignId = $input.first().json.body.campaignId;\nif (!/^[0-9a-f-]{36}$/i.test(String(campaignId))) throw new Error('campaignId missing or malformed');\n$execution.customData.set('campaignId', String(campaignId));\nreturn [{ json: { campaignId } }];"
      }
    },
    {
      "id": "n-bundle",
      "name": "Get prompt bundle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "url": "=APP_BASE_URL_HERE/api/campaigns/{{ $json.campaignId }}/bundle",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "bypass-tunnel-reminder",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PpHeaderAuth00001",
          "name": "Postpilot app secret"
        }
      }
    },
    {
      "id": "n-split",
      "name": "Split bundles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json;\nif (!Array.isArray(b.bundles) || !b.bundles.length) throw new Error('Bundle response had no prompts');\nreturn b.bundles.map((x) => ({ json: { campaignId: b.campaignId, model: b.model, responseSchema: b.responseSchema, platform: x.platform, candidateIndex: x.candidateIndex, system: x.system, user: x.user } }));"
      }
    },
    {
      "id": "n-genone",
      "name": "Generate & save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "PpHeaderAuth00001",
          "name": "Postpilot app secret"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "=APP_BASE_URL_HERE/api/campaigns/{{ $json.campaignId }}/generate-one",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: $json.platform, candidateIndex: $json.candidateIndex, system: $json.system, user: $json.user }) }}",
        "options": {
          "timeout": 90000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 6500
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Tag execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tag execution": {
      "main": [
        [
          {
            "node": "Get prompt bundle",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get prompt bundle": {
      "main": [
        [
          {
            "node": "Split bundles",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split bundles": {
      "main": [
        [
          {
            "node": "Generate & save",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}